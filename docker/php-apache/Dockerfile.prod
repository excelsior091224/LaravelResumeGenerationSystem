FROM node:24-bookworm AS frontend-build

WORKDIR /src
COPY src/package*.json ./
RUN npm install
COPY src/ .
RUN npm run build

FROM php:8.4-apache AS runtime

ARG NODE_MAJOR=24
ENV COMPOSER_ALLOW_SUPERUSER=1
ENV APP_ENV=production
ENV APP_DEBUG=false

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        unzip \
        curl \
        chromium \
        libsqlite3-dev \
        libicu-dev \
        libonig-dev \
        libzip-dev \
        libpng-dev \
        libjpeg62-turbo-dev \
        libfreetype6-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
        bcmath \
        exif \
        gd \
        intl \
        mbstring \
        pdo_sqlite \
        zip \
    && a2enmod rewrite ssl headers \
    && curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install --global npm@latest \
    && php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');" \
    && php composer-setup.php --install-dir=/usr/local/bin --filename=composer \
    && rm composer-setup.php \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
COPY docker/php-apache/000-default-prod.conf /etc/apache2/sites-available/000-default.conf
COPY docker/php-apache/entrypoint-prod.sh /usr/local/bin/entrypoint-prod.sh
RUN chmod +x /usr/local/bin/entrypoint-prod.sh

WORKDIR /var/www/html
COPY src/composer.json src/composer.lock* ./
RUN composer install --no-interaction --prefer-dist --no-progress --no-scripts --no-dev --optimize-autoloader

COPY src/ .
COPY --from=frontend-build /src/public/build /var/www/html/public/build

RUN mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views bootstrap/cache database \
    && chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache /var/www/html/database /var/www/html/public \
    && chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache /var/www/html/database \
    && chmod -R 755 /var/www/html/public

EXPOSE 80 443
CMD ["/usr/local/bin/entrypoint-prod.sh"]
