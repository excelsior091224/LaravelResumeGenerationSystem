{
    # 必要に応じて通知用メールを設定
    # email admin@example.com
}

(resume_app_common) {
    encode zstd gzip

    # 将来アプリを増やしたときも同じ形で reverse_proxy を追加できる
    reverse_proxy app:80

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
    }
}

resumefoundries.com, www.resumefoundries.com {
    # Cloudflare Full (strict) 用に Origin Certificate を利用
    tls /etc/caddy/certs/origin.crt /etc/caddy/certs/origin.key

    # 正規ドメインへ統一
    @www host www.resumefoundries.com
    redir @www https://resumefoundries.com{uri} 301

    import resume_app_common
}

# 追加ドメインは docker/caddy/sites/*.caddy を作成して追記
import /etc/caddy/sites/*.caddy
